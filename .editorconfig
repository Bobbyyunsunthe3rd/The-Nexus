# EditorConfig helps keep formatting consistent across editors & contributors.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown: keep trailing whitespace (it can be meaningful for line breaks)
[*.md]
trim_trailing_whitespace = false

# Config/data files conventionally use 2-space indent
[*.{yml,yaml,json,toml}]
indent_size = 2
